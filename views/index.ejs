<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>World Chat</title>
        <link rel="stylesheet" href="/stylesheets/style.css"/>
        <script src="https://cdn.socket.io/4.5.0/socket.io.min.js" crossorigin="anonymous"></script>
        <script defer src="/app.js"></script>
    </head>
    <body>
        <div class="chat-container">
            <h1>🌍 World Chat</h1>
            <div id="online-count"> 👥 0 online </div>
            <div id="welcome-user"></div>
            <div id="chats"></div>
            <form id="guess">
            <textarea id="chat" placeholder="Type your message..." required></textarea>
            <button type="submit">Send</button>
            </form>
        </div>
    </body>
</html>